{
  "name": "lp-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first multi-provider coding workbench",
  "author": "LP Studio",
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && node scripts/boundaries.mjs",
    "start": "node scripts/start.mjs",
    "pack:win": "npm run build && electron-builder --win dir --x64 && node scripts/portable.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "setup:mirror": "node scripts/install.mjs --source=mirror",
    "setup:official": "node scripts/install.mjs --source=official"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.lpstudio.workbench",
    "productName": "LP Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
